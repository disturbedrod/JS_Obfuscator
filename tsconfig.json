{
  "compilerOptions": {
    // esbuild bundles the extension, so resolve imports the way it does.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "outDir": "out",
    "rootDir": "src",
    "lib": ["ES2022"],
    "sourceMap": true,
    "strict": true
  },
  "include": ["src"]
}
